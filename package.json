{
  "name": "futuremode-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Futuremode Hackathon API",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "husky"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.99.1",
    "cors": "2.8.5",
    "dotenv": "17.3.1",
    "express": "5.2.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "22.19.3",
    "@types/supertest": "6.0.3",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "supertest": "7.2.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vitest": "4.0.16"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --max-warnings=0 --fix"
    ]
  }
}
